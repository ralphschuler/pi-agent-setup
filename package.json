{
  "name": "pi-agent-setup",
  "version": "0.1.0",
  "description": "Bootstrap repository for a custom pi agent setup with extensions, skills, prompts, themes, and install scripts.",
  "private": true,
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "extensions",
    "skills",
    "subagents",
    "processes"
  ],
  "type": "module",
  "scripts": {
    "install:pi": "bash scripts/install.sh",
    "uninstall:pi": "bash scripts/uninstall.sh",
    "update:pi": "bash scripts/update.sh",
    "check": "bash scripts/check.sh"
  },
  "dependencies": {
    "@aliou/pi-processes": "^0.8.1",
    "pi-subagents": "^0.24.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-agent-core": { "optional": true },
    "@mariozechner/pi-ai": { "optional": true },
    "@mariozechner/pi-coding-agent": { "optional": true },
    "@mariozechner/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/pi-subagents/src/extension/index.ts",
      "./node_modules/@aliou/pi-processes/src/index.ts"
    ],
    "skills": [
      "./skills",
      "./node_modules/pi-subagents/skills",
      "./node_modules/@aliou/pi-processes/skills/pi-processes"
    ],
    "prompts": [
      "./prompts",
      "./node_modules/pi-subagents/prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
